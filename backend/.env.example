# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/jobsite_intelligence"

# Anthropic API key — used for extraction (lib/extraction.ts) and Ask My Jobs
ANTHROPIC_API_KEY="sk-ant-..."

# Wire these once you pick an auth provider (see src/lib/auth.ts)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Email magic-link sign-in (Auth.js EmailProvider) — any SMTP provider works;
# Postmark/Resend/SES are common choices for transactional email
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="Foresite <noreply@yourdomain.com>"

# Stripe (spec §57) — required before enabling billing
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_STARTER="price_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_BUSINESS="price_..."
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shared secret for the /api/cron/daily-digest trigger. Vercel Cron sends this
# automatically as a Bearer token if this env var is set in your project.
CRON_SECRET="generate-with-openssl-rand-base64-32"

# Object storage for photo/PDF uploads (spec §58: private storage, signed URLs)
# Object storage for photo/PDF uploads (spec §58: private storage, signed URLs).
# Works with real AWS S3 (leave S3_ENDPOINT unset) or any S3-compatible provider
# (Cloudflare R2, Backblaze B2 — set S3_ENDPOINT to that provider's endpoint URL).
S3_BUCKET="foresite-uploads"
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
